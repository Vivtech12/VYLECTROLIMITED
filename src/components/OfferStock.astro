---

---

<section
	id="offer-stock"
	class="relative py-20 lg:py-32 bg-[#0a0412]"
>
	<div class="container mx-auto max-w-6xl px-8">
		<div class="rounded-3xl border border-gray-700 bg-gray-900/50 p-8 lg:p-12 backdrop-blur-sm">
			<div class="grid items-center gap-12 lg:grid-cols-2">
				<!-- Content -->
				<div class="space-y-6">
					<div
						class="mb-4 w-fit items-center rounded-full border border-indigo-500 bg-indigo-900/30 px-4 py-1.5"
					>
						<span class="text-sm font-medium text-indigo-300">
							For Suppliers
						</span>
					</div>
					<h2
						class="text-gradient-purple-glow text-3xl leading-tight font-bold md:text-4xl font-heading"
					>
						Have Stock to Offer?
					</h2>
					<p class="text-gray-300 leading-relaxed">
						We're always looking to expand our supplier network and source quality electronics.
						If you have stock to sell, we want to hear from you.
					</p>
					<ul class="space-y-3 text-gray-400">
						<li class="flex items-start gap-3">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-5 w-5 mt-0.5 text-indigo-400 shrink-0"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
							<span>Quick response to all stock offers</span>
						</li>
						<li class="flex items-start gap-3">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-5 w-5 mt-0.5 text-indigo-400 shrink-0"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
							<span>Fair and competitive purchasing prices</span>
						</li>
						<li class="flex items-start gap-3">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-5 w-5 mt-0.5 text-indigo-400 shrink-0"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
							<span>Build long-term supplier relationships</span>
						</li>
					</ul>
				</div>

				<!-- Form -->
				<div class="rounded-2xl border border-gray-600 bg-gray-800/50 p-6 lg:p-8">
					<h3 class="mb-6 text-xl font-semibold text-white">
						Submit Your Stock Offer
					</h3>
					<form
						action="https://submit-form.com/oNN6N4Ag6"
						method="POST"
						class="space-y-4"
					>
						<input type="hidden" name="_subject" value="New Stock Offer" />

						<div>
							<label for="offer-company" class="mb-2 block text-sm font-medium text-gray-300">
								Company Name
							</label>
							<input
								type="text"
								id="offer-company"
								name="company"
								required
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="Your company name"
							/>
						</div>

						<div>
							<label for="offer-email" class="mb-2 block text-sm font-medium text-gray-300">
								Email Address
							</label>
							<input
								type="email"
								id="offer-email"
								name="email"
								required
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="your@email.com"
							/>
						</div>

						<div>
							<label for="offer-phone" class="mb-2 block text-sm font-medium text-gray-300">
								Phone Number
							</label>
							<input
								type="tel"
								id="offer-phone"
								name="phone"
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="+44 7XXX XXXXXX"
							/>
						</div>

						<div>
							<label for="offer-details" class="mb-2 block text-sm font-medium text-gray-300">
								Stock Details
							</label>
							<textarea
								id="offer-details"
								name="stock_details"
								rows="4"
								required
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="Please describe the stock you have available (product types, quantities, condition, etc.)"
							></textarea>
						</div>

						<button
							type="submit"
							class="w-full rounded-lg bg-gradient-button-primary px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-gradient-button-hover hover:glow-purple"
						>
							Submit Stock Offer
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>
