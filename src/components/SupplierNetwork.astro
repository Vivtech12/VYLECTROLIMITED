---

---

<section
	id="supplier-network"
	class="relative py-20 lg:py-32 bg-linear-to-b from-black to-[#0a0412]"
>
	<div class="container mx-auto max-w-6xl px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2">
			<!-- Content -->
			<div class="space-y-6">
				<h2
					class="text-gradient-purple-glow text-4xl leading-tight font-bold md:text-5xl font-heading"
				>
					Extensive Supplier Network
				</h2>
				<p class="text-xl text-gray-300 leading-relaxed">
					Our strength lies in our relationships. We've built a vast network of trusted suppliers
					across the globe, giving us access to products at the best possible prices.
				</p>
				<p class="text-gray-400 leading-relaxed">
					This extensive network means we're never reliant on a single source. When one supplier's
					prices shift, we have alternatives ready. This flexibility allows us to consistently
					offer competitive pricing that helps your business thrive, regardless of market
					fluctuations.
				</p>

				<div class="pt-4 grid grid-cols-2 gap-6">
					<div class="rounded-xl border border-gray-700 bg-gray-800/50 p-5 backdrop-blur-sm">
						<div class="text-3xl font-bold text-gradient-purple-glow mb-1">
							Global
						</div>
						<div class="text-sm text-gray-400">Supplier Reach</div>
					</div>
					<div class="rounded-xl border border-gray-700 bg-gray-800/50 p-5 backdrop-blur-sm">
						<div class="text-3xl font-bold text-gradient-purple-glow mb-1">
							Direct
						</div>
						<div class="text-sm text-gray-400">Manufacturer Links</div>
					</div>
				</div>
			</div>

			<!-- Visual Element -->
			<div class="relative">
				<div class="relative rounded-2xl border border-gray-700 bg-gray-900/50 p-8 backdrop-blur-sm">
					<div class="space-y-6">
						<div class="flex items-center gap-4">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-6 w-6 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
									/>
								</svg>
							</div>
							<div>
								<h4 class="font-semibold text-white">Multiple Sourcing Channels</h4>
								<p class="text-sm text-gray-400">Never dependent on a single supplier</p>
							</div>
						</div>

						<div class="flex items-center gap-4">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-6 w-6 text-purple-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
									/>
								</svg>
							</div>
							<div>
								<h4 class="font-semibold text-white">Price Protection</h4>
								<p class="text-sm text-gray-400">Competitive rates through supplier diversity</p>
							</div>
						</div>

						<div class="flex items-center gap-4">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-6 w-6 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
									/>
								</svg>
							</div>
							<div>
								<h4 class="font-semibold text-white">Volume Advantages</h4>
								<p class="text-sm text-gray-400">Bulk buying power passed to you</p>
							</div>
						</div>

						<div class="flex items-center gap-4">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-6 w-6 text-purple-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
									/>
								</svg>
							</div>
							<div>
								<h4 class="font-semibold text-white">Quick Turnaround</h4>
								<p class="text-sm text-gray-400">Fast sourcing from multiple channels</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Decorative glow -->
				<div
					class="absolute -inset-4 -z-10 rounded-2xl bg-linear-to-r from-indigo-500/10 to-purple-500/10 blur-xl"
				></div>
			</div>
		</div>
	</div>
</section>
