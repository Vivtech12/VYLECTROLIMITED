---

---

<section
	id="who-we-supply"
	class="relative py-20 lg:py-32 bg-linear-to-b from-black to-[#0a0412]"
>
	<div class="container mx-auto max-w-6xl px-8">
		<div class="mb-16 w-full flex flex-col items-center">
			<h2
				class="text-gradient-purple-glow text-4xl leading-tight font-bold md:text-5xl font-heading mb-6"
			>
				Who We Supply
			</h2>
			<p class="text-gray-300 text-lg max-w-3xl text-center leading-relaxed">
				We work with businesses of all sizes across the UK, providing reliable electronics
				distribution to meet diverse needs.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mb-16">
			<!-- Distributors -->
			<div class="rounded-2xl border border-gray-700 bg-gray-900/50 p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-indigo-500">
				<div class="mb-4 flex h-16 w-16 mx-auto items-center justify-center rounded-full bg-indigo-600/20">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-8 w-8 text-indigo-400"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
						/>
					</svg>
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Distributors</h3>
				<p class="text-sm text-gray-400">
					Partner distributors looking to expand their product range
				</p>
			</div>

			<!-- Retailers -->
			<div class="rounded-2xl border border-gray-700 bg-gray-900/50 p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-indigo-500">
				<div class="mb-4 flex h-16 w-16 mx-auto items-center justify-center rounded-full bg-purple-600/20">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-8 w-8 text-purple-400"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
						/>
					</svg>
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Retailers</h3>
				<p class="text-sm text-gray-400">
					Online and high street retailers stocking consumer electronics
				</p>
			</div>

			<!-- Procurement Teams -->
			<div class="rounded-2xl border border-gray-700 bg-gray-900/50 p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-indigo-500">
				<div class="mb-4 flex h-16 w-16 mx-auto items-center justify-center rounded-full bg-indigo-600/20">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-8 w-8 text-indigo-400"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
						/>
					</svg>
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">Procurement Teams</h3>
				<p class="text-sm text-gray-400">
					Corporate procurement across various industries
				</p>
			</div>

			<!-- IT Departments -->
			<div class="rounded-2xl border border-gray-700 bg-gray-900/50 p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-indigo-500">
				<div class="mb-4 flex h-16 w-16 mx-auto items-center justify-center rounded-full bg-purple-600/20">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-8 w-8 text-purple-400"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
						/>
					</svg>
				</div>
				<h3 class="text-lg font-semibold text-white mb-2">IT Departments</h3>
				<p class="text-sm text-gray-400">
					Technology teams sourcing hardware solutions
				</p>
			</div>
		</div>

		<!-- IT Department Call Out -->
		<div class="rounded-2xl border border-indigo-500/50 bg-gray-900/70 p-8 lg:p-10 backdrop-blur-sm glow-purple">
			<div class="flex flex-col lg:flex-row items-center gap-8">
				<div class="flex-1 text-center lg:text-left">
					<h3 class="text-2xl font-bold text-white mb-4">
						Are You an IT Department Manager?
					</h3>
					<p class="text-gray-300 leading-relaxed mb-6 lg:mb-0">
						If you're managing an IT department and need to source technology for your organisation,
						we'd love to hear from you. Whether it's laptops for a new team, monitors for an office
						refresh, or any other tech requirements, we can help you find quality products at
						competitive prices. Get in touch today and let's discuss how we can support your IT needs.
					</p>
				</div>
				<div class="shrink-0">
					<a
						href="/contact"
						class="inline-flex items-center gap-2 rounded-lg bg-gradient-button-primary px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-gradient-button-hover hover:glow-purple-strong"
					>
						Get In Touch
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M17 8l4 4m0 0l-4 4m4-4H3"
							/>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
