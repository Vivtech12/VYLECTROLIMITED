---
import { Icon } from "astro-icon/components";
---

<section
	id="why-buy"
	class="relative py-20 lg:py-32 bg-black"
>
	<div class="container mx-auto max-w-6xl px-8">
		<div class="mb-16 w-full flex flex-col items-center">
			<h2
				class="text-gradient-purple-glow text-4xl leading-tight font-bold md:text-5xl font-heading mb-4"
			>
				Why Buy From Us
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl text-center">
				Partner with a distributor that puts your business first
			</p>
		</div>

		<div class="grid gap-8 md:grid-cols-3">
			<!-- Latest Products -->
			<div
				class="group rounded-2xl border border-gray-700 bg-gray-900/50 p-8 backdrop-blur-sm transition-all duration-300 hover:border-indigo-500 hover:glow-purple"
			>
				<div
					class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-button-primary"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-7 w-7 text-white"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M13 10V3L4 14h7v7l9-11h-7z"
						/>
					</svg>
				</div>
				<h3 class="mb-4 text-xl font-bold text-white">
					Latest In-Demand Products
				</h3>
				<p class="text-gray-400 leading-relaxed">
					We stay ahead of market trends, stocking the newest and most sought-after electronics.
					Our inventory is continuously updated to ensure you have access to products your customers
					actually want to buy, helping you stay competitive in a fast-moving market.
				</p>
			</div>

			<!-- Competitive Pricing -->
			<div
				class="group rounded-2xl border border-gray-700 bg-gray-900/50 p-8 backdrop-blur-sm transition-all duration-300 hover:border-indigo-500 hover:glow-purple"
			>
				<div
					class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-button-primary"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-7 w-7 text-white"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
						/>
					</svg>
				</div>
				<h3 class="mb-4 text-xl font-bold text-white">
					Competitive Pricing
				</h3>
				<p class="text-gray-400 leading-relaxed">
					Our extensive supplier network and bulk purchasing power allow us to offer prices that
					maximise your profit margins. We work hard to ensure our pricing remains competitive,
					giving you the edge you need to succeed in a price-sensitive market.
				</p>
			</div>

			<!-- Dedicated Support -->
			<div
				class="group rounded-2xl border border-gray-700 bg-gray-900/50 p-8 backdrop-blur-sm transition-all duration-300 hover:border-indigo-500 hover:glow-purple"
			>
				<div
					class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-button-primary"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-7 w-7 text-white"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
						/>
					</svg>
				</div>
				<h3 class="mb-4 text-xl font-bold text-white">
					Dedicated Support & Account Manager
				</h3>
				<p class="text-gray-400 leading-relaxed">
					Every client is assigned a dedicated account manager who understands your business needs.
					From order queries to product recommendations, you'll have a single point of contact
					committed to helping your business grow and resolving any issues promptly.
				</p>
			</div>
		</div>
	</div>
</section>
