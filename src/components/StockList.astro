---

---

<section
	id="stock-list"
	class="relative py-20 lg:py-32 bg-linear-to-b from-[#0a0412] to-black"
>
	<div class="container mx-auto max-w-6xl px-8">
		<div class="rounded-3xl border border-indigo-500/50 bg-gradient-purple-soft p-8 lg:p-12 glow-purple">
			<div class="grid items-center gap-12 lg:grid-cols-2">
				<!-- Form -->
				<div class="order-2 lg:order-1 rounded-2xl border border-gray-600 bg-gray-800/70 p-6 lg:p-8">
					<h3 class="mb-6 text-xl font-semibold text-white">
						Register for Stock Updates
					</h3>
					<form
						action="https://submit-form.com/oNN6N4Ag6"
						method="POST"
						class="space-y-4"
					>
						<input type="hidden" name="_subject" value="Stock List Registration" />

						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<label for="stocklist-firstname" class="mb-2 block text-sm font-medium text-gray-300">
									First Name
								</label>
								<input
									type="text"
									id="stocklist-firstname"
									name="first_name"
									required
									class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
									placeholder="John"
								/>
							</div>
							<div>
								<label for="stocklist-lastname" class="mb-2 block text-sm font-medium text-gray-300">
									Last Name
								</label>
								<input
									type="text"
									id="stocklist-lastname"
									name="last_name"
									required
									class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
									placeholder="Smith"
								/>
							</div>
						</div>

						<div>
							<label for="stocklist-company" class="mb-2 block text-sm font-medium text-gray-300">
								Company Name
							</label>
							<input
								type="text"
								id="stocklist-company"
								name="company"
								required
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="Your company name"
							/>
						</div>

						<div>
							<label for="stocklist-email" class="mb-2 block text-sm font-medium text-gray-300">
								Business Email
							</label>
							<input
								type="email"
								id="stocklist-email"
								name="email"
								required
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="your@company.com"
							/>
						</div>

						<div>
							<label for="stocklist-phone" class="mb-2 block text-sm font-medium text-gray-300">
								Phone Number
							</label>
							<input
								type="tel"
								id="stocklist-phone"
								name="phone"
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="+44 7XXX XXXXXX"
							/>
						</div>

						<div>
							<label for="stocklist-interests" class="mb-2 block text-sm font-medium text-gray-300">
								Product Categories of Interest
							</label>
							<textarea
								id="stocklist-interests"
								name="interests"
								rows="3"
								class="w-full rounded-lg border border-gray-600 bg-gray-700/50 px-4 py-3 text-white placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
								placeholder="e.g., Smartphones, Laptops, Gaming Consoles, Audio Equipment..."
							></textarea>
						</div>

						<button
							type="submit"
							class="w-full rounded-lg bg-gradient-button-primary px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-gradient-button-hover hover:glow-purple-strong"
						>
							Register for Stock List
						</button>
					</form>
				</div>

				<!-- Content -->
				<div class="order-1 lg:order-2 space-y-6">
					<div
						class="mb-4 w-fit items-center rounded-full border border-purple-500 bg-purple-900/30 px-4 py-1.5"
					>
						<span class="text-sm font-medium text-purple-300">
							For Buyers
						</span>
					</div>
					<h2
						class="text-gradient-purple-glow text-3xl leading-tight font-bold md:text-4xl font-heading"
					>
						Get Access to Our Stock List
					</h2>
					<p class="text-gray-300 leading-relaxed">
						Register to receive our regularly updated stock list featuring the latest electronics
						at competitive wholesale prices. Be the first to know about new arrivals and special offers.
					</p>
					<ul class="space-y-4 text-gray-400">
						<li class="flex items-start gap-3">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-4 w-4 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<span>Regular stock updates delivered to your inbox</span>
						</li>
						<li class="flex items-start gap-3">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-4 w-4 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<span>Early access to limited availability items</span>
						</li>
						<li class="flex items-start gap-3">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-4 w-4 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<span>Exclusive wholesale pricing for registered buyers</span>
						</li>
						<li class="flex items-start gap-3">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600/20">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-4 w-4 text-indigo-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<span>No obligation - browse at your convenience</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>
