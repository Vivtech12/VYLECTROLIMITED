---
const brands = [
	"PlayStation",
	"Apple",
	"Sony",
	"Microsoft",
	"Samsung",
	"LG",
	"Nintendo",
	"Bose",
	"JBL",
	"HP",
	"Lenovo",
	"Dell",
	"Canon",
	"Philips",
	"Logitech",
	"Panasonic",
];
---

<section class="py-10 pt-8 pb-4 text-white lg:pt-72">
	<div class="w-full flex justify-center">
		<h2
			class="mt-6 text-2xl leading-8 font-bold text-gradient-purple-glow"
		>
			Brands We Stock
		</h2>
	</div>
	<div
		class="logos group relative overflow-hidden py-10 whitespace-nowrap lg:pt-12 lg:pb-24"
		style="mask-image: linear-gradient(to right, transparent 0px, white 128px, white calc(100% - 128px), transparent 100%);"
	>
		<div
			class="group-hover:animation-pause animate-slide-left-infinite inline-block w-max"
		>
			<div class="flex items-center">
				{
					brands.map((brand) => (
						<div class="flex h-11 w-auto items-center px-10 lg:px-16">
							<span class="text-xl lg:text-2xl font-bold text-white/80 tracking-wide">
								{brand}
							</span>
						</div>
					))
				}
			</div>
		</div>
		<div
			class="group-hover:animation-pause animate-slide-left-infinite inline-block w-max"
		>
			<div class="flex items-center">
				{
					brands.map((brand) => (
						<div class="flex h-11 w-auto items-center px-10 lg:px-16">
							<span class="text-xl lg:text-2xl font-bold text-white/80 tracking-wide">
								{brand}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
